# Copy the values you need into your shell environment. The app reads them from the
# environment; it does not load this file by itself.

# Optional. With a key, submissions get criterion scores and written feedback from Claude.
# Without one, the app runs offline and shows measured checks only.
ANTHROPIC_API_KEY=

# "offline" or "anthropic". Defaults to "anthropic" when a key is set, otherwise "offline".
EEC_PROVIDER=

# Claude model used for feedback.
EEC_MODEL=claude-sonnet-5-5

# Where your practice history is stored (a single SQLite file).
EEC_DB_PATH=data/coach.db
